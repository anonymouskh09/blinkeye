# RecruitPro Candidate Importer — extension environment
#
# Vite only exposes variables prefixed with VITE_ to the bundle.
# Copy this file to .env (development) or .env.production (production build)
# and adjust the values. Never commit real .env files.

# Development
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_BASE_URL=http://localhost:3000

# Production (example placeholders — replace with real domains)
# VITE_API_BASE_URL=https://api.example.com
# VITE_APP_BASE_URL=https://app.example.com

# Set to "true" ONLY for local development to enable the paste-token
# connection fallback. Must be "false"/absent for production builds.
VITE_ALLOW_DEV_TOKEN=true
