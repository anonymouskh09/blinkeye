{
  "name": "recruitpro-candidate-importer",
  "version": "1.0.0",
  "description": "Chrome extension to import LinkedIn candidate profiles into the RecruitPro ATS.",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "prebuild": "npm run gen:icons",
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "node scripts/zip.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.26",
    "@types/chrome": "0.0.287",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
