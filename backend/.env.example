DATABASE_URL=postgresql://postgres:password@localhost:5432/recruitment_db
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=./app/uploads
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@agency.com
ADMIN_PASSWORD=Admin123!
ENVIRONMENT=development

FRONTEND_URL=http://localhost:3000

# Chrome extension (LinkedIn Candidate Importer)
EXTENSION_ACCESS_EXPIRE_MINUTES=60
EXTENSION_REFRESH_EXPIRE_DAYS=30
EXTENSION_CODE_EXPIRE_SECONDS=300
# Optional extra CORS origins for the extension, comma-separated.
# The popup/service worker are exempt from CORS via host_permissions, so this is
# usually only needed if you call the API from an extension *page* context.
# Example: chrome-extension://<your-extension-id>
EXTENSION_CORS_ORIGINS=
# Dev-only: allow the extension to connect with a pasted JWT (never enable in prod).
EXTENSION_ALLOW_DEV_TOKEN=false
